{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python -m app.prepare_hosting",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "includeFiles": ".model/**",
      "excludeFiles": "{tests/**,.venv/**,.cache/**,__pycache__/**}"
    }
  }
}
