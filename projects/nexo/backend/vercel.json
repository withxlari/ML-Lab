{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "buildCommand": "python -m app.prepare_hosting",
  "functions": {
    "app/main.py": {
      "maxDuration": 300,
      "includeFiles": ".model/**",
      "excludeFiles": "{tests/**,.venv/**,.cache/**,__pycache__/**}"
    }
  },
  "regions": [
    "gru1"
  ],
  "crons": [
    {
      "path": "/api/v1/internal/showcase",
      "schedule": "0 9 * * *"
    }
  ]
}
