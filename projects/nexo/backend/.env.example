NEXO_ENVIRONMENT=development
NEXO_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

NEXO_CATALOG_SOURCE=local
# Change to supabase only after creating and seeding the Nexo catalog table.
# NEXO_SUPABASE_URL=https://your-project.supabase.co
# NEXO_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# TMDB account > Settings > API > API Read Access Token. Backend only.
# NEXO_TMDB_READ_TOKEN=

# IGDB: Twitch Developer Console > application type Confidential. Backend only.
# NEXO_IGDB_CLIENT_ID=
# NEXO_IGDB_CLIENT_SECRET=

# Google Cloud Console > enable Books API > API key restricted to Books API. Backend only.
# NEXO_GOOGLE_BOOKS_API_KEY=
